# Firebase web config (Project settings -> General -> Your apps -> Web app)
# These values are public identifiers, not secrets. Security is enforced by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Only this Google account may use the app (kept out of the repo - set it locally and as a GitHub secret)
VITE_ALLOWED_EMAIL=
